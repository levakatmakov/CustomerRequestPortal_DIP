@model CustomerRequestPortal.ViewModels.AnalyticsViewModel
@{
    ViewData["Title"] = "Аналитика";
    var maxMonthAmount = Model.MonthlyRevenue.Any() ? Model.MonthlyRevenue.Max(m => m.Amount) : 0;
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-chart-line"></i> Аналитика заявок</h1>
        <p class="page-subtitle">Ключевые показатели заявок, продаж и складских остатков</p>
    </div>
    <a asp-controller="Requests" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-clipboard-list"></i> К заявкам
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card stat-card-blue">
            <div class="card-body">
                <div class="stat-label">Всего заявок</div>
                <div class="stat-value">@Model.TotalRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-green">
            <div class="card-body">
                <div class="stat-label">Общая сумма</div>
                <div class="stat-value">@Model.TotalRevenue.ToString("N0") ₽</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-orange">
            <div class="card-body">
                <div class="stat-label">За текущий месяц</div>
                <div class="stat-value">@Model.MonthRevenue.ToString("N0") ₽</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-red">
            <div class="card-body">
                <div class="stat-label">Низкий остаток</div>
                <div class="stat-value">@Model.LowStockProductsCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-tasks"></i> Заявки по статусам</h5>
            </div>
            <div class="card-body">
                @foreach (var item in Model.StatusSummary)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>@item.Status</span>
                            <strong>@item.Count (@item.Percent%)</strong>
                        </div>
                        <div class="progress analytics-progress">
                            <div class="progress-bar" role="progressbar" style="width: @item.Percent%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-calendar-alt"></i> Динамика за 6 месяцев</h5>
            </div>
            <div class="card-body">
                <div class="bar-chart">
                    @foreach (var month in Model.MonthlyRevenue)
                    {
                        var height = maxMonthAmount == 0 ? 4 : Math.Max(8, (int)(month.Amount / maxMonthAmount * 100));
                        <div class="bar-chart-item">
                            <div class="bar-value">@month.Amount.ToString("N0") ₽</div>
                            <div class="bar-column" style="height: @height%"></div>
                            <div class="bar-label">@month.Month</div>
                            <small class="text-muted">@month.RequestsCount заявок</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-star"></i> Популярные товары</h5>
            </div>
            <div class="card-body">
                @if (Model.PopularProducts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Кол-во</th>
                                    <th>Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.PopularProducts)
                                {
                                    <tr>
                                        <td>@product.ProductName</td>
                                        <td><strong>@product.Quantity</strong></td>
                                        <td>@product.Amount.ToString("N2") ₽</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mb-0">Данных по товарам пока нет.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-triangle-exclamation"></i> Товары с низким остатком</h5>
            </div>
            <div class="card-body">
                @if (Model.LowStockProducts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Категория</th>
                                    <th>Остаток</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td>@product.Name</td>
                                        <td>@product.Category</td>
                                        <td>
                                            <span class="badge bg-warning text-dark">@product.StockQuantity @product.Unit</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-0">Критичных остатков нет.</div>
                }
            </div>
        </div>
    </div>
</div>
