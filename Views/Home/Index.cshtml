@{
    ViewData["Title"] = "Главная";
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-warehouse"></i> СтройСклад</h1>
        <p class="page-subtitle">Система управления клиентскими заявками и складским каталогом</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span class="badge bg-light text-dark border">
            @(User.IsInRole(AppRoles.Administrator) ? "Рабочее место администратора" : User.IsInRole(AppRoles.Dispatcher) ? "Рабочее место диспетчера" : User.IsInRole(AppRoles.Executor) ? "Рабочее место исполнителя" : "Кабинет клиента")
        </span>
    }
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-icon"><i class="fas fa-clipboard-list"></i></div>
                    <h3 class="h5">Заявки</h3>
                    <p class="text-muted">Просмотр заявок, статусов, сумм и истории обработки.</p>
                    <a asp-controller="Requests" asp-action="Index" class="btn btn-primary">Перейти к заявкам</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-icon"><i class="fas fa-store"></i></div>
                    <h3 class="h5">Каталог</h3>
                    <p class="text-muted">Поиск строительных материалов, категорий, цен и остатков.</p>
                    <a asp-controller="Products" asp-action="Catalog" class="btn btn-primary">Открыть каталог</a>
                </div>
            </div>
        </div>

        @if (User.IsInRole(AppRoles.Customer))
        {
            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-plus-circle"></i></div>
                        <h3 class="h5">Новая заявка</h3>
                        <p class="text-muted">Оформление заявки на товары с автоматическим расчетом суммы.</p>
                        <a asp-controller="Requests" asp-action="Create" class="btn btn-primary">Создать заявку</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-bell"></i></div>
                        <h3 class="h5">Уведомления</h3>
                        <p class="text-muted">Изменения статусов и комментарии по вашим заявкам.</p>
                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-primary">Посмотреть</a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole(AppRoles.Dispatcher) || User.IsInRole(AppRoles.Administrator))
        {
            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-chart-line"></i></div>
                        <h3 class="h5">Аналитика</h3>
                        <p class="text-muted">Итоги по заявкам, популярные товары и контроль остатков.</p>
                        <a asp-controller="Analytics" asp-action="Index" class="btn btn-primary">Открыть аналитику</a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole(AppRoles.Administrator))
        {
            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-box"></i></div>
                        <h3 class="h5">Товары</h3>
                        <p class="text-muted">Управление ассортиментом, ценами, категориями и остатками.</p>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Управление товарами</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-users-gear"></i></div>
                        <h3 class="h5">Пользователи</h3>
                        <p class="text-muted">Создание диспетчеров, исполнителей и администраторов.</p>
                        <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Управление пользователями</a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole(AppRoles.Executor))
        {
            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <div class="dashboard-icon"><i class="fas fa-truck-ramp-box"></i></div>
                        <h3 class="h5">Мои задания</h3>
                        <p class="text-muted">Проверка наличия, комплектация и подготовка к отгрузке.</p>
                        <a asp-controller="Requests" asp-action="Index" class="btn btn-primary">Открыть задания</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="dashboard-icon mx-auto"><i class="fas fa-user-lock"></i></div>
                    <h3>Вход в систему</h3>
                    <p class="text-muted">Авторизуйтесь, чтобы работать с заявками, каталогом и отчетами.</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt"></i> Войти
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-user-plus"></i> Регистрация
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
