@model IEnumerable<CustomerRequestPortal.Models.CustomerRequest>
@{
    ViewData["Title"] = "Заявки";
    var currentStatus = ViewBag.Status as string;
    var currentPriority = ViewBag.Priority as string;
    var currentSort = ViewBag.Sort as string ?? "date_desc";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size: 1.1rem; padding: 20px;">
        <i class="fas fa-check-circle fa-2x"></i>
        <div class="ms-3">
            <strong>Успешно!</strong><br>
            @TempData["Success"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-clipboard-list"></i> @(User.IsInRole(AppRoles.Customer) ? "Мои заявки" : User.IsInRole(AppRoles.Executor) ? "Назначенные заявки" : "Все заявки клиентов")</h1>
        <p class="page-subtitle">Поиск, фильтрация и контроль обработки клиентских заявок</p>
    </div>
    @if (User.IsInRole(AppRoles.Customer))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Создать заявку
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card stat-card-blue">
            <div class="card-body">
                <div class="stat-label">Найдено заявок</div>
                <div class="stat-value">@ViewBag.TotalRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-info">
            <div class="card-body">
                <div class="stat-label">Новые</div>
                <div class="stat-value">@ViewBag.NewRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-orange">
            <div class="card-body">
                <div class="stat-label">Назначены</div>
                <div class="stat-value">@ViewBag.AssignedRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-green">
            <div class="card-body">
                <div class="stat-label">Завершены</div>
                <div class="stat-value">@ViewBag.CompletedRequests</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label class="form-label">Поиск</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Номер, название, клиент или описание" />
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="Новая" selected="@(currentStatus == "Новая")">Новая</option>
                    <option value="Назначена" selected="@(currentStatus == "Назначена")">Назначена</option>
                    <option value="Подтверждено наличие" selected="@(currentStatus == "Подтверждено наличие")">Подтверждено наличие</option>
                    <option value="Комплектуется" selected="@(currentStatus == "Комплектуется")">Комплектуется</option>
                    <option value="Готов к отгрузке" selected="@(currentStatus == "Готов к отгрузке")">Готов к отгрузке</option>
                    <option value="Завершена" selected="@(currentStatus == "Завершена")">Завершена</option>
                    <option value="Отклонена" selected="@(currentStatus == "Отклонена")">Отклонена</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Приоритет</label>
                <select name="priority" class="form-select">
                    <option value="">Любой</option>
                    <option value="Высокий" selected="@(currentPriority == "Высокий")">Высокий</option>
                    <option value="Средний" selected="@(currentPriority == "Средний")">Средний</option>
                    <option value="Низкий" selected="@(currentPriority == "Низкий")">Низкий</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Сортировка</label>
                <select name="sort" class="form-select">
                    <option value="date_desc" selected="@(currentSort == "date_desc")">Сначала новые</option>
                    <option value="date_asc" selected="@(currentSort == "date_asc")">Сначала старые</option>
                    <option value="amount_desc" selected="@(currentSort == "amount_desc")">Сумма по убыванию</option>
                    <option value="amount_asc" selected="@(currentSort == "amount_asc")">Сумма по возрастанию</option>
                    <option value="priority" selected="@(currentSort == "priority")">По приоритету</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="fas fa-filter"></i> Найти
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4>Заявок пока нет</h4>
                @if (User.IsInRole(AppRoles.Customer))
                {
                    <p class="text-muted">Создайте свою первую заявку!</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Создать заявку
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>№ Заявки</th>
                        <th>Название</th>
                        @if (!User.IsInRole(AppRoles.Customer))
                        {
                            <th>Клиент</th>
                        }
                        <th>Исполнитель</th>
                        <th>Статус</th>
                        <th>Приоритет</th>
                        <th>Сумма</th>
                        <th>Дата</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.RequestNumber</strong></td>
                            <td>@item.Title</td>
                            @if (!User.IsInRole(AppRoles.Customer))
                            {
                                <td>@item.User?.FullName</td>
                            }
                            <td>@(item.AssignedExecutor?.FullName ?? "-")</td>
                            <td>
                                @if (item.Status == "Новая")
                                {
                                    <span class="badge badge-status-new">Новая</span>
                                }
                                else if (item.Status == "Назначена" || item.Status == "Подтверждено наличие" || item.Status == "Комплектуется")
                                {
                                    <span class="badge badge-status-work">@item.Status</span>
                                }
                                else if (item.Status == "Готов к отгрузке" || item.Status == "Завершена")
                                {
                                    <span class="badge badge-status-done">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-rejected">Отклонена</span>
                                }
                            </td>
                            <td>
                                @if (item.Priority == "Высокий")
                                {
                                    <span class="badge bg-danger">Высокий</span>
                                }
                                else if (item.Priority == "Средний")
                                {
                                    <span class="badge bg-warning text-dark">Средний</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Низкий</span>
                                }
                            </td>
                            <td><strong>@item.TotalAmount.ToString("N2") ₽</strong></td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Просмотр
                                </a>
                                @if (User.IsInRole(AppRoles.Administrator))
                                {
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Удалить заявку @item.RequestNumber?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Удалить
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>
