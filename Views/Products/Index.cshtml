@model IEnumerable<CustomerRequestPortal.Models.Product>
@{
    ViewData["Title"] = "Управление товарами";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCategory = ViewBag.Category as string;
    var currentAvailability = ViewBag.Availability as string;
    var currentSort = ViewBag.Sort as string ?? "name";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-box"></i> Управление товарами</h1>
        <p class="page-subtitle">Каталог, категории, цены и складские остатки</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Добавить товар
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card stat-card-blue">
            <div class="card-body">
                <div class="stat-label">Найдено товаров</div>
                <div class="stat-value">@ViewBag.TotalProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-green">
            <div class="card-body">
                <div class="stat-label">Активные</div>
                <div class="stat-value">@ViewBag.ActiveProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-orange">
            <div class="card-body">
                <div class="stat-label">Низкий остаток</div>
                <div class="stat-value">@ViewBag.LowStockProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-red">
            <div class="card-body">
                <div class="stat-label">Нет в наличии</div>
                <div class="stat-value">@ViewBag.OutOfStockProducts</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label class="form-label">Поиск</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Название или описание товара" />
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Категория</label>
                <select name="category" class="form-select">
                    <option value="">Все категории</option>
                    @foreach (var categoryItem in categories)
                    {
                        <option value="@categoryItem" selected="@(currentCategory == categoryItem)">@categoryItem</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Наличие</label>
                <select name="availability" class="form-select">
                    <option value="">Все товары</option>
                    <option value="active" selected="@(currentAvailability == "active")">Активные</option>
                    <option value="inactive" selected="@(currentAvailability == "inactive")">Неактивные</option>
                    <option value="in_stock" selected="@(currentAvailability == "in_stock")">В наличии</option>
                    <option value="low_stock" selected="@(currentAvailability == "low_stock")">Низкий остаток</option>
                    <option value="out_of_stock" selected="@(currentAvailability == "out_of_stock")">Нет в наличии</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Сортировка</label>
                <select name="sort" class="form-select">
                    <option value="name" selected="@(currentSort == "name")">По названию</option>
                    <option value="category" selected="@(currentSort == "category")">По категории</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Цена по убыванию</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Цена по возрастанию</option>
                    <option value="stock_desc" selected="@(currentSort == "stock_desc")">Остаток по убыванию</option>
                    <option value="stock_asc" selected="@(currentSort == "stock_asc")">Остаток по возрастанию</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="fas fa-filter"></i> Найти
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <h4>Товаров пока нет</h4>
                <p class="text-muted">Добавьте первый товар в каталог!</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Добавить товар
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Цена</th>
                            <th>Единица</th>
                            <th>Остаток</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var stockClass = item.StockQuantity <= 0 ? "table-danger" : item.StockQuantity <= 100 ? "table-warning" : "";
                            <tr class="@stockClass">
                                <td>
                                    <strong>@item.Name</strong>
                                    <br />
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.Category</span>
                                </td>
                                <td>
                                    <strong>@item.Price.ToString("N2") ₽</strong>
                                </td>
                                <td>@item.Unit</td>
                                <td>
                                    @if (item.StockQuantity <= 0)
                                    {
                                        <span class="text-danger fw-bold">
                                            <i class="fas fa-ban"></i> Нет в наличии
                                        </span>
                                    }
                                    else if (item.StockQuantity <= 100)
                                    {
                                        <span class="text-danger">
                                            <i class="fas fa-exclamation-triangle"></i> @item.StockQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            <i class="fas fa-check-circle"></i> @item.StockQuantity
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        if (item.StockQuantity <= 0)
                                        {
                                            <span class="badge bg-secondary">Нет в наличии</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Активен</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Неактивен</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Удалить">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> На главную
    </a>
</div>
