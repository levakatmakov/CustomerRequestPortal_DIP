@model CustomerRequestPortal.Models.Product
@{
    ViewData["Title"] = "Добавление товара";
}

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-plus-circle"></i> Добавление нового товара</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label">Название товара *</label>
                    <input asp-for="Name" class="form-control" placeholder="Например: Цемент М500" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Category" class="form-label">Категория</label>
                    <input asp-for="Category" class="form-control" list="categories" />
                    <datalist id="categories">
                        <option value="Сухие смеси" />
                        <option value="Кирпич" />
                        <option value="Блоки" />
                        <option value="Пиломатериалы" />
                        <option value="Кровля" />
                        <option value="Утеплители" />
                        <option value="Бетон" />
                        <option value="Сыпучие" />
                    </datalist>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Описание товара..."></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Price" class="form-label">Цена (₽) *</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Unit" class="form-label">Единица измерения *</label>
                    <input asp-for="Unit" class="form-control" placeholder="шт, м³, кг, мешок" required />
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StockQuantity" class="form-label">Остаток на складе *</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" required />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label">Активный товар (будет виден клиентам)</label>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save"></i> Добавить товар
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-times"></i> Отмена
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}