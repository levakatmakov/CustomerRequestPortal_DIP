@model IEnumerable<CustomerRequestPortal.Models.RequestStatusHistory>
@{
    ViewData["Title"] = "Уведомления";
    var groups = Model
        .Where(item => item.Request != null)
        .GroupBy(item => item.Request!)
        .OrderByDescending(group => group.Max(item => item.ChangedAt))
        .ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-bell"></i> Уведомления</h1>
        <p class="page-subtitle">Изменения статусов и комментарии по вашим заявкам</p>
    </div>
    <a asp-controller="Requests" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-clipboard-list"></i> Мои заявки
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (!groups.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-bell-slash fa-4x text-muted mb-3"></i>
                <h4>Уведомлений пока нет</h4>
                <p class="text-muted mb-0">Когда статус заявки изменится, сообщение появится здесь.</p>
            </div>
        }
        else
        {
            <div class="d-grid gap-4">
                @foreach (var group in groups)
                {
                    var request = group.Key;
                    var lastNotification = group.OrderByDescending(item => item.ChangedAt).First();

                    <div class="border rounded p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h2 class="h5 mb-1">
                                    <a asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">
                                        @request.RequestNumber
                                    </a>
                                </h2>
                                <div class="text-muted">@request.Title</div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border">@request.Status</span>
                                <div class="text-muted small mt-1">Последнее: @lastNotification.ChangedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="timeline">
                            @foreach (var item in group.OrderByDescending(item => item.ChangedAt))
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="d-flex justify-content-between flex-wrap gap-2">
                                            <strong>
                                                @if (string.IsNullOrEmpty(item.OldStatus))
                                                {
                                                    <span>Заявка создана</span>
                                                }
                                                else
                                                {
                                                    <span>@item.OldStatus -> @item.NewStatus</span>
                                                }
                                            </strong>
                                            <span class="text-muted">@item.ChangedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                        <div class="text-muted">@(item.ChangedByUser?.FullName ?? "Система")</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                                        {
                                            <div class="mt-2">@item.Comment</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
